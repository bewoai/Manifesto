# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/
*.spec

# Veri / PII — gerçek planlama ve manifesto dosyaları repo'ya konmaz (KVKK, brief §10)
*.xlsx
*.xlsm
# PII'siz şablon hariç tutulabilir (gitignore satır içi yorumu desteklemez)
!data/manifest_template.xlsx
data/*.db
data/incoming/

# Ortam
.env
node_modules/
dist/
build/
.tools/

# Sırlar & yerel hata-ayıklama PII — ASLA commit'lenmez
# (Google servis hesabı anahtarları vb.; data/country_map.json etkilenmez)
/app/*.json
*service-account*.json
*-credentials*.json
ocr_debug.txt

# Codex / yerel doğrulama çıktıları
/review.db
/review_settings.json
/browser-review.log
/browser-review.err.log
/secret-test.dat
/tmp/
/pytest_temp/
/setup_build/

# Codex review çalışma zamanı (cihaz kimliği + yerel db)
/.review-runtime/
# PII'siz test kopyaları (maskelenmiş; gerçek veri buraya konmaz)
!tests/fixtures/*.xlsx

# Impeccable tasarım turu: görseller ve ekran görüntüleri (büyük, yerel)
.impeccable/mocks/
.impeccable/review/
.impeccable/questions/
